# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
# Supabase session pooler (port 5432, IPv4) for the app. Production form:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitness
# Same Supabase session pooler URI (port 5432) for prisma migrate.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/fitness
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-plus-random-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Requests per minute per client IP on /auth/* and /me.
AUTH_RATE_LIMIT_PER_MINUTE=10
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=30
EXPORT_RATE_LIMIT_PER_HOUR=5
EXPORT_MAX_ROWS=5000
EXPORT_MAX_SESSIONS=2000
EXPORT_MAX_PLAN_VERSIONS=200
EXPORT_MAX_SETS_TOTAL=20000
EXPORT_MAX_PLAN_EXERCISES_TOTAL=10000
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# Proxies in front of the app on Render: Cloudflare edge + Render proxy = 2.
# Use 0 for local development with no proxy.
TRUST_PROXY_HOPS=2
CORS_ORIGINS=
SWAGGER_ENABLED=true
