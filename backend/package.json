{
  "name": "fitness-backend",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "test": "prisma generate && jest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy",
    "contract:lint": "redocly lint ../contracts/openapi.yaml --config ../contracts/redocly.yaml",
    "db:seed": "tsx prisma/seed.ts",
    "migrate:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/testing": "^11.1.0",
    "@redocly/cli": "^2.65.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.0.0",
    "jest": "^30.0.0",
    "prisma": "7.10.1",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "yaml": "^2.9.1"
  }
}
